#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "robot_description"
    doc = """Generated from Composed Stage of root layer /tmp/tmp8vg4l618/robot_description.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_robot_description_vw02t18w/usdex_robot_description/robot_description.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_robot_description_vw02t18w/temp_robot_description/robot_description.usd


Generated from Composed Stage of root layer /home/zar/Documents/phd/robot/openmover_ws/isaac/assets/openmover_lab/robot_description/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "robot_description" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "ball_front_left_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "ball_front_right_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "ball_rear_left_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "ball_rear_right_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wheel_left_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wheel_right_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "ball_front_left_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "ball_front_right_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "ball_rear_left_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "ball_rear_right_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "wheel_left_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "wheel_right_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }
}

