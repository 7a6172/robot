<?xml version="1.0"?>
<!--
  Pioneer 3DX robot description for ROS 2 Jazzy + Gazebo Harmonic (gz-sim8).
  Faithful port of warehouse_simulation_toolkit/urdf/pioneer3dx*.xacro:
  identical link/joint geometry and inertias; gazebo-classic plugins replaced
  by gz-sim8 systems (DiffDrive, JointStatePublisher, gpu_lidar sensor).
  The ground-truth p3d plugin from ROS 1 was unused by any node and is dropped.
-->
<robot name="pioneer3dx" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ================= chassis ================= -->
  <link name="base_link">
    <inertial>
      <mass value="40.0"/>
      <origin xyz="-0.045 0 0.148"/>
      <inertia ixx="0.3338" ixy="0" ixz="0" iyy="0.4783" iyz="0" izz="0.3338"/>
    </inertial>
    <visual>
      <origin xyz="-0.045 0 0.148" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_simulation/meshes/chassis.stl"/>
      </geometry>
      <material name="">
        <color rgba="0.851 0 0 1"/>
      </material>
    </visual>
    <collision>
      <!-- ROS 1 had this box centered at base_link origin, which put it 8.5 cm
           BELOW the wheel bottoms (robot rested on the box, wheels in the air).
           Center it on the actual chassis so wheels/caster carry the robot. -->
      <origin xyz="-0.045 0 0.148" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.28 0.17"/>
      </geometry>
    </collision>
  </link>

  <!-- ================= top plate ================= -->
  <link name="top_plate">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_simulation/meshes/top.stl"/>
      </geometry>
      <material name="">
        <color rgba="0.038 0.038 0.038 1"/>
      </material>
    </visual>
  </link>
  <joint name="base_top_joint" type="fixed">
    <origin xyz="-0.045 0 0.24" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="top_plate"/>
  </joint>

  <!-- ================= front sonar ================= -->
  <link name="front_sonar">
    <inertial>
      <mass value="0.0001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_simulation/meshes/front_sonar.stl"/>
      </geometry>
      <material name="">
        <color rgba="0.715 0.583 0.210 1"/>
      </material>
    </visual>
  </link>
  <joint name="base_front_joint" type="fixed">
    <origin xyz="-0.198 0 0.208" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_sonar"/>
  </joint>

  <!-- ================= rear sonar ================= -->
  <link name="back_sonar">
    <inertial>
      <mass value="0.0001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_simulation/meshes/back_sonar.stl"/>
      </geometry>
      <material name="">
        <color rgba="0.715 0.583 0.210 1"/>
      </material>
    </visual>
  </link>
  <joint name="base_back_joint" type="fixed">
    <origin xyz="0.109 0 0.209" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="back_sonar"/>
  </joint>

  <!-- ================= swivel + caster wheel ================= -->
  <link name="swivel">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_simulation/meshes/swivel.stl"/>
      </geometry>
      <material name="">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>
  <joint name="base_swivel_joint" type="continuous">
    <origin xyz="-0.185 0 0.055" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <parent link="base_link"/>
    <child link="swivel"/>
  </joint>

  <link name="center_wheel">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.012411765597" ixy="-0.000711733678" ixz="0.00050272983" iyy="0.015218160428" iyz="-0.000004273467" izz="0.011763977943"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_simulation/meshes/center_wheel.stl"/>
      </geometry>
      <material name="">
        <color rgba="0.038 0.038 0.038 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.0375" length="0.0314"/>
      </geometry>
    </collision>
  </link>
  <joint name="swivel_wheel_joint" type="continuous">
    <origin xyz="-0.026 0 -0.016" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <parent link="swivel"/>
    <child link="center_wheel"/>
  </joint>

  <link name="center_hubcap">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.012411765597" ixy="-0.000711733678" ixz="0.00050272983" iyy="0.015218160428" iyz="-0.000004273467" izz="0.011763977943"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_simulation/meshes/center_hubcap.stl"/>
      </geometry>
      <material name="">
        <color rgba="0.85 0.72 0 1"/>
      </material>
    </visual>
  </link>
  <joint name="center_wheel_joint" type="fixed">
    <origin xyz="-0.0035 0 -0.001" rpy="0 0 0"/>
    <parent link="center_wheel"/>
    <child link="center_hubcap"/>
  </joint>

  <!-- ================= wheel macro ================= -->
  <xacro:macro name="pioneer_wheel" params="prefix reflect">
    <link name="${prefix}_hub">
      <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.012411765597" ixy="0" ixz="0" iyy="0.015218160428" iyz="0" izz="0.011763977943"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://warehouse_simulation/meshes/${prefix}_hubcap.stl"/>
        </geometry>
        <material name="">
          <color rgba="0.85 0.72 0 1"/>
        </material>
      </visual>
    </link>
    <joint name="base_${prefix}_hubcap_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}_wheel"/>
      <child link="${prefix}_hub"/>
    </joint>

    <link name="${prefix}_wheel">
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.012411765597" ixy="0" ixz="0" iyy="0.015218160428" iyz="0" izz="0.011763977943"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://warehouse_simulation/meshes/${prefix}_wheel.stl"/>
        </geometry>
        <material name="">
          <color rgba="0.038 0.038 0.038 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="-1.5707963 0 0"/>
        <geometry>
          <cylinder radius="0.09" length="0.04"/>
        </geometry>
      </collision>
    </link>
    <joint name="base_${prefix}_wheel_joint" type="continuous">
      <axis xyz="0 1 0"/>
      <origin xyz="0 ${reflect * 0.158} 0.091" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <!-- Cap drive torque per wheel (ROS 1 used wheelTorque=5). DART's velocity
           servo clips its impulse to this effort limit, so a blocked robot
           pushes gently (wheels stall) instead of bouncing off obstacles.
           The old mu1/mu2/kp/kd tags were removed: kp=1e8 + kd=1 made DART
           contacts ultra-stiff and bouncy; DART defaults (mu=1) are stable. -->
      <limit effort="5" velocity="100"/>
    </joint>
  </xacro:macro>

  <xacro:pioneer_wheel prefix="left" reflect="1"/>
  <xacro:pioneer_wheel prefix="right" reflect="-1"/>

  <!-- ================= imu (link only; nothing consumes /imu in this demo) ================= -->
  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="base_imu_joint" type="fixed">
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <!-- ================= hokuyo laser ================= -->
  <link name="laser">
    <visual>
      <!-- lds.stl vertices span z -30.2..+9.0 mm, so at joint z=0.30 the puck
           bottom floats 2.7 cm above the top plate (top 0.243). Drop the visual
           only (TF/sensor frame stays at ROS 1's 0.30) so the puck rests on the
           plate exactly as it appears in the ROS 1 simulation. -->
      <origin xyz="0 0 -0.0268" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_simulation/meshes/lds.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.015 0 -0.0065" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.114"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="base_scan_joint" type="fixed">
    <!-- ROS 1 ground truth: laser sits centered above base at z=0.30 -->
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="laser"/>
  </joint>

  <!-- ================= gz-sim8 colors ================= -->
  <gazebo reference="base_link">
    <material>
      <ambient>0.851 0 0 1.0</ambient>
      <diffuse>0.851 0 0 1.0</diffuse>
    </material>
  </gazebo>
  <gazebo reference="top_plate">
    <material>
      <ambient>0.038 0.038 0.038 1.0</ambient>
      <diffuse>0.038 0.038 0.038 1.0</diffuse>
    </material>
  </gazebo>
  <gazebo reference="front_sonar">
    <material>
      <ambient>0.715 0.583 0.210 1.0</ambient>
      <diffuse>0.715 0.583 0.210 1.0</diffuse>
    </material>
  </gazebo>
  <gazebo reference="back_sonar">
    <material>
      <ambient>0.715 0.583 0.210 1.0</ambient>
      <diffuse>0.715 0.583 0.210 1.0</diffuse>
    </material>
  </gazebo>
  <gazebo reference="swivel">
    <material>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <diffuse>0.5 0.5 0.5 1.0</diffuse>
    </material>
  </gazebo>
  <gazebo reference="center_wheel">
    <material>
      <ambient>0.038 0.038 0.038 1.0</ambient>
      <diffuse>0.038 0.038 0.038 1.0</diffuse>
    </material>
  </gazebo>
  <gazebo reference="center_hubcap">
    <material>
      <ambient>0.85 0.72 0 1.0</ambient>
      <diffuse>0.85 0.72 0 1.0</diffuse>
    </material>
  </gazebo>
  <gazebo reference="left_wheel">
    <material>
      <ambient>0.038 0.038 0.038 1.0</ambient>
      <diffuse>0.038 0.038 0.038 1.0</diffuse>
    </material>
  </gazebo>
  <gazebo reference="right_wheel">
    <material>
      <ambient>0.038 0.038 0.038 1.0</ambient>
      <diffuse>0.038 0.038 0.038 1.0</diffuse>
    </material>
  </gazebo>
  <gazebo reference="left_hub">
    <material>
      <ambient>0.85 0.72 0 1.0</ambient>
      <diffuse>0.85 0.72 0 1.0</diffuse>
    </material>
  </gazebo>
  <gazebo reference="right_hub">
    <material>
      <ambient>0.85 0.72 0 1.0</ambient>
      <diffuse>0.85 0.72 0 1.0</diffuse>
    </material>
  </gazebo>
  <!-- ROS 1 used Gazebo/FlatBlack for the lidar -->
  <gazebo reference="laser">
    <material>
      <ambient>0.1 0.1 0.1 1.0</ambient>
      <diffuse>0.1 0.1 0.1 1.0</diffuse>
    </material>
  </gazebo>

  <!-- ================= gz DiffDrive (replaces gazebo classic differential drive) ================= -->
  <gazebo>
    <plugin name="gz::sim::systems::DiffDrive" filename="gz-sim-diff-drive-system">
      <left_joint>base_left_wheel_joint</left_joint>
      <right_joint>base_right_wheel_joint</right_joint>
      <wheel_separation>0.32</wheel_separation>
      <wheel_radius>0.09</wheel_radius>
      <max_linear_acceleration>3.0</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <odom_topic>pioneer_odom</odom_topic>
      <tf_topic>pioneer_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
    </plugin>
  </gazebo>

  <!-- joint states for robot_state_publisher (swivel + caster + wheels) -->
  <gazebo>
    <plugin name="gz::sim::systems::JointStatePublisher" filename="gz-sim-joint-state-publisher-system">
      <topic>pioneer_joint_states</topic>
      <joint_name>base_swivel_joint</joint_name>
      <joint_name>swivel_wheel_joint</joint_name>
      <joint_name>base_left_wheel_joint</joint_name>
      <joint_name>base_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ================= gpu lidar (Gazebo Harmonic only supports gpu_lidar) ================= -->
  <gazebo reference="laser">
    <sensor type="gpu_lidar" name="lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <gz_frame_id>laser</gz_frame_id>
      <update_rate>5.0</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.008</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
