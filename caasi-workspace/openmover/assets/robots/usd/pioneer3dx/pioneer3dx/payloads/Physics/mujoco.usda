over "pioneer3dx"
{
    over "Physics"
    {
        def MjcActuator "base_swivel_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </pioneer3dx/Physics/base_swivel_joint>
        }

        def MjcActuator "swivel_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </pioneer3dx/Physics/swivel_wheel_joint>
        }

        def MjcActuator "base_left_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = 5
            uniform double mjc:forceRange:min = -5
            custom rel mjc:target
            prepend rel mjc:target = </pioneer3dx/Physics/base_left_wheel_joint>
        }

        def MjcActuator "base_right_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = 5
            uniform double mjc:forceRange:min = -5
            custom rel mjc:target
            prepend rel mjc:target = </pioneer3dx/Physics/base_right_wheel_joint>
        }

