<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>swjtumover_bringup</name>
  <version>0.1.0</version>
  <description>
    Hardware bringup for the swjtumover robot, migrated to ROS 2 from the ROS 1 package of the
    same name. Motor driver, screen driver, teleoperation, launch and robot model.
  </description>
  <maintainer email="dev@example.com">swjtumover</maintainer>
  <license>private</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>swjtumover_msgs</depend>
  <depend>swjtumover_vanjee</depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
