<launch>
    <node pkg="amcl" type="amcl" name="amcl" output="screen">
<param name="min_particles" value="2000"/>
        <param name="max_particles" value="5000"/>
    
        <param name="laser_min_range" value="-1"/>
        <param name="laser_max_range" value="10"/>
        <param name="laser_lambda_short" value="0.1"/>
        <param name="laser_sigma_hit" value="0.2"/>

        <param name="update_min_d" value="0.03"/>
        <param name="update_min_a" value="0.05"/>
        <param name="resample_interval" value="1"/>
        <param name="transform_tolerance" value="0.2"/>
        <param name="odom_model_type" value="diff"/>
        <param name="pf_err" value="0.05"/>
        <param name="pf_z" value="0.95"/>

        <param name="laser_model_type" value="likelihood_field_prob"/>
        <param name="beam_skip_distance" value="0.25"/>
        <param name="beam_skip_threshold" value="0.2"/>
        <param name="max_beams" value="200"/>

        <param name="do_beamskip" value="true"/>
        <param name="z_hit" value="0.9"/>

        <param name="z_rand" value="0.1"/>
        <param name="sigma_hit" value="0.05"/>
        <param name="lambda_short" value="0.1"/>

        <param name="odom_alpha1" value="0.95"/>
        <param name="odom_alpha2" value="0.95"/>
        <param name="odom_alpha3" value="0.95"/>
        <param name="odom_alpha4" value="0.95"/>
        <param name="recovery_alpha_fast" value="0.000"/>
        <param name="recovery_alpha_slow" value="0.0"/>
    </node>
</launch>