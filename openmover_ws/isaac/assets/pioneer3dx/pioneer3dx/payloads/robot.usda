#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "pioneer3dx"
    doc = """Generated from Composed Stage of root layer /tmp/tmpfaykwkf9/pioneer3dx.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_pioneer3dx_h52iqoza/usdex_pioneer3dx/pioneer3dx.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_pioneer3dx_h52iqoza/temp_pioneer3dx/pioneer3dx.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "pioneer3dx" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </pioneer3dx/Physics/base_top_joint>,
        </pioneer3dx/Physics/base_front_joint>,
        </pioneer3dx/Physics/base_back_joint>,
        </pioneer3dx/Physics/base_swivel_joint>,
        </pioneer3dx/Physics/base_left_wheel_joint>,
        </pioneer3dx/Physics/base_right_wheel_joint>,
        </pioneer3dx/Physics/base_imu_joint>,
        </pioneer3dx/Physics/base_scan_joint>,
        </pioneer3dx/Physics/swivel_wheel_joint>,
        </pioneer3dx/Physics/center_wheel_joint>,
        </pioneer3dx/Physics/base_left_hubcap_joint>,
        </pioneer3dx/Physics/base_right_hubcap_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </pioneer3dx/Geometry/base_link>,
        </pioneer3dx/Geometry/base_link/top_plate>,
        </pioneer3dx/Geometry/base_link/front_sonar>,
        </pioneer3dx/Geometry/base_link/back_sonar>,
        </pioneer3dx/Geometry/base_link/swivel>,
        </pioneer3dx/Geometry/base_link/swivel/center_wheel>,
        </pioneer3dx/Geometry/base_link/swivel/center_wheel/center_hubcap>,
        </pioneer3dx/Geometry/base_link/left_wheel>,
        </pioneer3dx/Geometry/base_link/left_wheel/left_hub>,
        </pioneer3dx/Geometry/base_link/right_wheel>,
        </pioneer3dx/Geometry/base_link/right_wheel/right_hub>,
        </pioneer3dx/Geometry/base_link/imu_link>,
        </pioneer3dx/Geometry/base_link/laser>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "chassis" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
            }

            over "top_plate" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "top" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                }
            }

            over "front_sonar" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "front_sonar" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                }
            }

            over "back_sonar" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "back_sonar" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                }
            }

            over "swivel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "swivel" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                }

                over "center_wheel" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "center_wheel" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                    }

                    over "center_hubcap" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "center_hubcap" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "left_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "left_wheel" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                }

                over "left_hub" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "left_hubcap" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                    }
                }
            }

            over "right_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "right_wheel" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                }

                over "right_hub" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_hubcap" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                    }
                }
            }

            over "laser" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "lds" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                }
            }

            over "imu_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "base_top_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_front_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_back_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_swivel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "swivel_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "center_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_left_hubcap_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_right_hubcap_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_imu_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_scan_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

