    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "robot_description"
{
    over "Physics"
    {
        def MjcActuator "ball_front_left_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </robot_description/Physics/ball_front_left_joint>
        }

        def MjcActuator "ball_front_right_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </robot_description/Physics/ball_front_right_joint>
