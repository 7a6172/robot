            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </robot_description/Physics/ball_rear_right_joint>
        }

        def MjcActuator "wheel_left_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </robot_description/Physics/wheel_left_joint>
