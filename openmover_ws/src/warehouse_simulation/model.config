<?xml version="1.0"?>
<!-- 仅为让 gz 能把 share/warehouse_simulation 目录识别为合法模型目录，
     从而解析 URDF 中 package://warehouse_simulation/meshes/*.stl
     （gz 会把 package:// 转成 model://）。 -->
<model>
  <name>warehouse_simulation</name>
  <version>1.0</version>
  <description>Resource-only model dir for pioneer3dx meshes.</description>
</model>
