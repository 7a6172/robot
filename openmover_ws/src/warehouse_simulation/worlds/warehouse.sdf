    <!--create moving objects -->
    <!-- 迁移自 ROS 1 warehouse.world 的两个行走人物 actor；
         walk.dae 为 gz Harmonic 官方教程使用的资产。
         路点 x/y 与时间序列与 ROS 1 一致；z 由 ROS 1 的 0 抬升至 1.0，
         以适配 gz Harmonic actor 的皮肤锚点高度（防止模型陷入地面）。
         注：gz Harmonic 的 actor 无物理碰撞体，靠激光雷达感知避让。 -->
    <actor name="actor1">
      <skin>
        <filename>model://actor/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>model://actor/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint>
            <time>0.0</time>
            <pose>-6 -4 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>25.0</time>
            <pose>7 -4 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>30</time>
            <pose>7 -4 1.0 0 0 3.14</pose>
          </waypoint>
          <waypoint>
            <time>55</time>
            <pose>-6 -4 1.0 0 0 3.14</pose>
          </waypoint>
          <waypoint>
            <time>60.0</time>
            <pose>-6 -4 1.0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="actor2">
      <skin>
        <filename>model://actor/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>model://actor/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="1" type="walking">
          <waypoint>
            <time>0.0</time>
            <pose>7 4 1.0 0 0 3.14</pose>
          </waypoint>
          <waypoint>
            <time>45.0</time>
            <pose>-6 4 1.0 0 0 3.14</pose>
          </waypoint>
          <waypoint>
            <time>50</time>
            <pose>-6 4 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>75</time>
            <pose>7 4 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>80.0</time>
            <pose>7 4 1.0 0 0 3.14</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- 行人碰撞不做物理近似：真实机器人靠激光雷达感知移动目标并由
         Nav2 避让/停车，本世界仅保证 actor 对雷达可见（渲染网格即可）。 -->
      </world>
</sdf>
