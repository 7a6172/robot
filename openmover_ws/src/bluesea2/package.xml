<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bluesea2</name>
  <version>2.0.0</version>
  <description>
    ROS 2 driver for Bluesea LiDAR units (ROS 2 port of the ROS 1 bluesea2 driver).
  </description>
  <maintainer email="zar@my.swjtu.edu.cn">zar</maintainer>
  <author email="support@lhlidar.com">Bluesea Technology (original ROS 1 vendor driver)</author>
  <author email="zar@my.swjtu.edu.cn">zar (manual ROS 2 port)</author>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
