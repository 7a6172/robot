  <!-- 主动轮差速驱动设置 -->
  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>50</updateRate>
      <legacyMode>true</legacyMode>
      <leftJoint>wheel_left_joint</leftJoint>
      <rightJoint>wheel_right_joint</rightJoint>
      <wheelSeparation>0.324</wheelSeparation>
      <wheelDiameter>0.1007</wheelDiameter>
      <torque>20</torque>
      <commandTopic>openmover/control/cmd_vel_sim</commandTopic>
      <odometryTopic>openmover/hardware/odom_sim</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_link</robotBaseFrame>
      <publishWheelTF>false</publishWheelTF>
      <publishWheelJointState>false</publishWheelJointState>
      <publishOdomTF>false</publishOdomTF>
      <rosDebugLevel>na</rosDebugLevel>
      <wheelAcceleration>0</wheelAcceleration>
      <wheelTorque>20</wheelTorque>
      <odometrySource>world</odometrySource>
      <publishTf>1</publishTf>
    </plugin>
  </gazebo>

  <!-- 雷达设置 -->
  <gazebo reference="lidar_forward_link">
    <sensor type="ray" name="lidar_forward">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>15</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>600</samples>
            <resolution>1</resolution>
            <min_angle>-1.57</min_angle>
            <max_angle>1.57</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.22</min>
          <max>10.0</max>
          <resolution>0.03</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="laser_forward_controller" filename="libgazebo_ros_laser.so">
        <topicName>openmover/hardware/lidar_forward/scan</topicName>
        <frameName>lidar_forward_link</frameName>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="lidar_rear_link">
    <sensor type="ray" name="lidar_rear">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>15</update_rate>
      <ray>
